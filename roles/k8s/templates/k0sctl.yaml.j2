apiVersion: k0sctl.k0sproject.io/v1beta1
kind: Cluster
metadata:
  name: k0s-cluster
spec:
  hosts:
{% for host in groups.kube_master %}
  - ssh:
      address: {{ host }}
      user: {{ ansible_user }}
      port: 22
    role: controller
{% endfor %}
{% for host in groups.kube_worker %}
  - ssh:
      address: {{ host }}
      user: {{ ansible_user }}
      port: 22
    role: worker
{% endfor %}
  k0s:
    version: {{ k0s_version }}
{% if k8s_pod_cidr is defined %}
    config:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        network:
          podCIDR: {{ k8s_pod_cidr }}
          serviceCIDR: {{ k8s_service_cidr }}
{% endif %}
  options:
    drain:
      ignoreDaemonSets: true
      deleteEmptyDirData: true
      force: true
      gracePeriod: 300
      timeout: 600